# EditorConfig — garantit une cohérence de formatage entre tous les éditeurs
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[*.py]
indent_size = 4

[*.html]
indent_size = 2